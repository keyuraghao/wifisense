// Copy to config.h and fill in. config.h is gitignored: it holds your WiFi
// password.
//
//     cp config.h.example config.h
//
// Or generate it: .venv/bin/python scripts/setup_firmware.py --ssid ... --pass ...
#pragma once

// ---------------------------------------------------------------- network ---
// ESP32 (classic, and S2/S3/C3) is 2.4 GHz ONLY. If your router advertises the
// same SSID on both bands this still works - the node simply associates on
// 2.4 GHz. But if 5 GHz has its own SSID, you must use the 2.4 GHz one here.
#define CFG_WIFI_SSID   "YOUR_2G_SSID"
#define CFG_WIFI_PASS   "YOUR_PASSWORD"

// The machine running scripts/rti_dashboard.py. Give it a DHCP reservation on
// your router, or this breaks the next time its lease changes.
#define CFG_SERVER_IP   "192.168.1.100"
#define CFG_SERVER_PORT 9999

// ----------------------------------------------------------------- timing ---
#define CFG_BEACON_INTERVAL_MS 40    // ~25 beacons/s per node
#define CFG_REPORT_INTERVAL_MS 200   // 5 reports/s to the server
#define CFG_PEER_STALE_MS      3000  // forget a peer after this silence

// Heartbeat LED.
//   -1  auto: use whatever the selected board declares (RGB_BUILTIN or
//       LED_BUILTIN). This is the portable choice and the default.
//   -2  disable entirely.
//   >=0 an explicit GPIO number.
// Auto is what keeps this sketch board-independent: an S3 DevKit has an
// addressable RGB LED on GPIO48 that digitalWrite cannot drive, a classic
// DevKitC has a plain LED on GPIO2, and some boards have neither.
#define CFG_LED_PIN -1
